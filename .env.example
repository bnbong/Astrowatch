# Astrowatch 환경변수 — 이 파일을 복사해 .env 로 저장하고 값을 채운다.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
# .env 는 커밋하지 않는다(.gitignore). 맥북으로 옮길 때는 .env 를 직접 복사한다.

# ── LLM · SSAFY GMS ─────────────────────────────────────────
# 키 이름은 GMS_KEY 또는 GMS_API_KEY 둘 다 읽는다.
GMS_KEY=
# anthropic(기본): GMS 의 Anthropic 호환 경로, 모델 claude-haiku-5-5 (1회 1크레딧)
# openai        : GMS 의 OpenAI 호환 경로, 모델 gpt-6-luna (2026-11-20 현재 사용 불가)
LLM_PROVIDER=anthropic
# 비우면 공급자 기본값: anthropic → https://gms.ssafy.io/gmsapi/api.anthropic.com/v1
#                      openai    → https://gms.ssafy.io/gmsapi/api.openai.com/v1/
OPENAI_BASE_URL=
# 비우면 공급자 기본 모델 (anthropic claude-haiku-5-5 / openai gpt-6-luna)
LLM_MODEL=
LLM_REASONING_EFFORT=none        # openai 공급자 전용. gpt-6-luna 는 tools 사용 시 none 필수
EMBEDDING_MODEL=text-embedding-3-small        # 심화 F3022(RAG)에서만 사용

# ── 공공데이터포털 (천문현상·출몰·월령·단기예보·중기예보 공통 키 1개) ──
# 마이페이지 → 활용신청 현황 → "일반 인증키(Decoding)" 값을 넣는다.
# Encoding 값(%2B, %3D 가 섞인 것)을 넣으면 requests 가 다시 인코딩해 401 이 난다.
DATA_GO_KR_KEY=

# ── 카카오 로컬 (REST API 키) ─────────────────────────────────
KAKAO_REST_KEY=

# ── 날씨 공급자 ─────────────────────────────────────────────
# kma  : 기상청 단기예보(~3일) + 중기예보(~10일)
# mock : 검증용. 모든 시간을 흐림으로 고정해 재계획·상한 도달을 재현한다
WEATHER_PROVIDER=kma
# 선택: 10일 밖 백업(OpenWeatherMap 5일/3h). 비우면 "예보 없음"으로 처리
OPENWEATHER_KEY=

# ── Agent 실행 설정 ─────────────────────────────────────────
MAX_REPLANS=3            # 재계획 상한 (NF3004)
MIN_OBS_MINUTES=30       # 충족 판정 최소 관측 시간
TIMEZONE=Asia/Seoul

# ── 저장소 ─────────────────────────────────────────────────
DB_PATH=data/astrowatch.db
CHROMA_DIR=data/chroma   # 심화 F3022

# ── Google Calendar (심화 F3023) ─────────────────────────────
# OAuth "데스크톱 앱" 클라이언트 JSON 과 발급된 토큰. 둘 다 secrets/ 에 두고 커밋하지 않는다.
CALENDAR_PROVIDER=local  # local | google
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
GOOGLE_CALENDAR_ID=primary

# ── 서버 ───────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000

# ── 보안 (docs/SETUP.md "보안 설정") ─────────────────────────
# 허용 출처(CORS · CSRF 가드)는 http://127.0.0.1:{APP_PORT}, http://localhost:{APP_PORT},
# http://{APP_HOST}:{APP_PORT}(0.0.0.0 이 아닐 때)가 기본이다.
# 터널·LAN 데모 때 브라우저 주소를 쉼표로 추가한다 (예: https://xxxx.trycloudflare.com). 비우면 기본만.
APP_ALLOWED_ORIGINS=
# 배포 주소 (예: https://astrowatch.onrender.com). 허용 출처와 Host 에 자동 포함. Render 는 RENDER_EXTERNAL_URL 을 자동으로 주므로 비워도 된다
APP_PUBLIC_URL=
# Host 헤더 추가 허용 (쉼표, 포트 제외). 127.0.0.1 · localhost · APP_HOST · APP_ALLOWED_ORIGINS 의 호스트는 자동 허용.
# APP_HOST=0.0.0.0 으로 LAN 에 열 때는 접속에 쓸 IP 를 여기에 적는다 (예: 192.168.0.10)
APP_ALLOWED_HOSTS=
# 터널·LAN 데모 때 설정: 값이 있으면 /api/* (health 제외) 요청에 X-Astrowatch-Token 헤더가 같아야 한다.
# 브라우저는 처음 401 을 받으면 입력 폼을 띄우고 탭(sessionStorage)에만 보관한다. 길고 무작위인 값을 쓴다.
APP_ACCESS_TOKEN=
# /api/chat 클라이언트 IP 당 분당 요청 수 (LLM · 외부 API 비용 보호)
CHAT_RATE_PER_MIN=12
# POST /api/logs/{id}/audit (지금 판정, LLM 진단) 클라이언트 IP 당 분당 요청 수
AUDIT_RATE_PER_MIN=6
# 저장소(루트) 밖 절대 경로를 DB_PATH · CHROMA_DIR · GOOGLE_* 에 쓰려면 1. 기본은 거부(경고 후 기능 비활성)
ALLOW_EXTERNAL_PATHS=0

# ── 심화 F3020 (이상 징후) / F3021 (Planner/Worker) / F3022 (RAG) ──
# AGENT_STRUCTURE=planner_worker      # planner_worker(기본) | classic — 구조 변경 전후 비교용
# WORKER_LLM=1                        # Worker 가 고칠 여지가 있는 실패(NO_RESULT 등)에만 LLM 판단. 0 이면 규칙만
# WORKER_MAX_RETRY=2                  # 같은 Tool 재시도 상한
# AUDIT_LLM=1                         # 이상으로 판정한 실행에만 LLM 원인 진단
# AUDIT_REPLAN_THRESHOLD=3            # 재계획이 이 횟수 이상이면 과다 재계획
# EMBEDDING_PROVIDER=local            # local(chromadb 내장 ONNX, 키 불필요) | gms(OpenAI 호환 임베딩 API)
# SPACE_DOCS_FILE=data/space_docs.json
